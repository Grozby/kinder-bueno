# Comments stay on their own lines: Docker's env_file reads `KEY=   # comment` as the value "# comment".
KEERA_API_KEY=
LLM_BASE_URL=https://gateway.keera.ch/api/v1
LLM_MODEL=apertus-v1-5-70b
LLM_CONCURRENCY=8
EMBED_MODEL=BAAI/bge-m3
# Cross-encoder for case need matching
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Host tools only; Docker builds its own from POSTGRES_PASSWORD
DATABASE_URL=postgresql://navigator:navigator@localhost:5432/navigator
JUDGE_ENABLED=true
# Optional, empty = LLM_MODEL: model for the claim judge (e.g. apertus-v1-5-8b when the gateway is slow)
JUDGE_MODEL=
# Optional, empty = LLM_MODEL: model for extraction only (e.g. apertus-v1-5-8b)
EXTRACT_MODEL=
# Optional, empty = LLM_MODEL: model for "why it matches" (e.g. apertus-v1-5-8b when the gateway is slow)
EXPLAIN_MODEL=
# Optional: require `Authorization: Bearer <token>` on /api; the UI's proxy adds it
API_TOKEN=
# Optional, default: config/sources.yaml and eval/ in the checkout (installed as a package: the working directory)
# SOURCES_FILE=/path/to/sources.yaml
# EVAL_DIR=/path/to/eval
# Docker database password (empty = navigator)
POSTGRES_PASSWORD=
# Packaged stack, built UI on 127.0.0.1:8080 only (docs/HANDOFF.md):
# COMPOSE_FILE=docker-compose.yml:docker-compose.handoff.yml
