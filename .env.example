KEERA_API_KEY=
LLM_BASE_URL=https://gateway.keera.ch/api/v1
LLM_MODEL=apertus-v1-5-70b
LLM_CONCURRENCY=8
EMBED_MODEL=BAAI/bge-m3
DATABASE_URL=postgresql://navigator:navigator@localhost:5432/navigator  # host tools; Docker builds its own from POSTGRES_PASSWORD
JUDGE_ENABLED=true
JUDGE_MODEL=                # optional: model for the claim judge (e.g. apertus-v1-5-8b when the gateway is slow)
EXTRACT_MODEL=              # optional: model for extraction only (e.g. apertus-v1-5-8b)
EXPLAIN_MODEL=              # optional: model for "why it matches" (e.g. apertus-v1-5-8b when the gateway is slow)
API_TOKEN=                  # optional: require `Authorization: Bearer <token>` on /api; the UI's proxy adds it
POSTGRES_PASSWORD=          # Docker database password (default: navigator)
# COMPOSE_FILE=docker-compose.yml:docker-compose.handoff.yml   # packaged stack: built UI on :8080 only (docs/HANDOFF.md)
