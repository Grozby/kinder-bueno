# Serves the UI and proxies /api to the backend on the same origin (no CORS). The proxy adds the API token,
# so the browser never sees it. ${BACKEND_URL} and ${API_TOKEN} are filled in from the environment at start.
server {
    listen 80;
    root /usr/share/nginx/html;

    client_max_body_size 12m;  # case uploads: the API answers 413 above 10 MB

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        proxy_read_timeout 180s;  # search, chat and case analysis wait on the LLM gateway
        proxy_send_timeout 180s;
    }

    location /assets/ {
        expires 1y;  # file names carry a content hash
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;  # history-mode routes such as /sources
        add_header Cache-Control "no-cache";
    }
}
